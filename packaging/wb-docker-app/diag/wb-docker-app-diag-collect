#!/bin/sh
# wb-docker-app diagnostic collector (design.md §3.5.1, issue #5).
#
# Invoked by wb-diag-collect as a single `command` entry (see the drop-in
# 60wb-docker-app.conf). It prints, to stdout, the systemd status and recent
# journal logs of every wb-docker-app service instance, plus the helper's own
# view of installed apps. wb-diag-collect captures this stdout into the archive
# under the configured filename, so a support engineer sees each containerized
# service's state and logs alongside the native WB services.
#
# The set of instances is discovered from running container labels (`wb.app`),
# the same self-describing source of truth the CLI `list`/`status` verbs use —
# no extra state file. Everything runs read-only and never fails the collect:
# missing docker/systemd just yields an empty/annotated section.
set -u

LINES=200

say() {
	printf '===== %s =====\n' "$1"
}

# Apps from running container labels (same source as `wb-docker-app list`).
apps=""
if command -v docker >/dev/null 2>&1; then
	apps=$(docker ps --filter label=wb.app \
		--format '{{ index .Labels "wb.app" }}' 2>/dev/null \
		| sort -u)
fi

say "wb-docker-app: installed services (wb.app labels)"
if [ -z "$apps" ]; then
	echo "(no running wb-docker-app containers, or docker unavailable)"
fi
echo "$apps"
echo

# Also surface enabled/known instances even if their container is down, so a
# crashed service is still visible in the archive.
units=""
if command -v systemctl >/dev/null 2>&1; then
	units=$(systemctl list-units --all --type=service --no-legend --plain \
		'wb-docker-app@*.service' 2>/dev/null | awk '{print $1}')
fi

# Union of label-derived apps (as units) and systemd-known units.
for app in $apps; do
	units="$units
wb-docker-app@${app}.service"
done
units=$(printf '%s\n' "$units" | sed '/^$/d' | sort -u)

if [ -z "$units" ]; then
	say "wb-docker-app: service instances"
	echo "(no wb-docker-app@*.service instances found)"
	exit 0
fi

for unit in $units; do
	say "systemctl status: $unit"
	if command -v systemctl >/dev/null 2>&1; then
		systemctl status "$unit" --no-pager 2>&1 || true
	else
		echo "(systemctl unavailable)"
	fi
	echo

	say "journalctl (last $LINES): $unit"
	if command -v journalctl >/dev/null 2>&1; then
		journalctl -u "$unit" --no-pager -n "$LINES" 2>&1 || true
	else
		echo "(journalctl unavailable)"
	fi
	echo
done

exit 0
