#!/usr/bin/make -f
# Vendor node-red + the WB palette via npm. The runtime ships as a tarball;
# postinst extracts it to /mnt/data.
export DH_VERBOSE = 1

DESTDIR  := debian/wb-node-red
LIBDIR   := $(DESTDIR)/usr/lib/wb-node-red
SHAREDIR := $(DESTDIR)/usr/share/wb-node-red

%:
	dh $@

override_dh_auto_build:
	cd vendor && npm ci --omit=dev --no-audit --no-fund
	# drop the platform-specific @node-rs/bcrypt to keep Architecture: all (NR5 falls back to bcryptjs)
	rm -rf vendor/node_modules/@node-rs
	# CRA: ship a CycloneDX SBOM of the vendored tree (needs npm >= 10).
	cd vendor && npm sbom --sbom-format cyclonedx --omit=dev --omit=optional > sbom.cdx.json

override_dh_auto_install:
	# Runtime tree -> reproducible tarball under /usr/share (postinst extracts it).
	install -d $(SHAREDIR)
	tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='@0' \
		-czf $(SHAREDIR)/node_modules.tar.gz -C vendor node_modules
	install -D -m 0644 config/settings.js $(LIBDIR)/settings.js
	install -D -m 0644 config/flows.json $(SHAREDIR)/flows.json
	install -D -m 0644 config/custom-menu.json $(SHAREDIR)/custom-menu.json
	install -D -m 0644 nginx/wb-node-red.conf $(SHAREDIR)/nginx/wb-node-red.conf
	install -D -m 0644 nginx/wb-node-red-auth-cache.conf $(SHAREDIR)/nginx/wb-node-red-auth-cache.conf
	install -D -m 0644 nginx/wb-node-red-redirect.conf $(SHAREDIR)/nginx/wb-node-red-redirect.conf
	install -D -m 0644 apt/52wb-node-red-no-unattended $(DESTDIR)/etc/apt/apt.conf.d/52wb-node-red-no-unattended
	install -D -m 0644 vendor/sbom.cdx.json $(DESTDIR)/usr/share/wb-node-red/sbom.cdx.json

override_dh_installsystemd:
	# Stop before the upgrade swap, start after — avoids an editor-port collision.
	dh_installsystemd --no-restart-after-upgrade

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf vendor/node_modules
	rm -f vendor/sbom.cdx.json
