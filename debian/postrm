#!/bin/sh
# Remove the runtime tree on remove/purge. The gate declaration is a plain
# package file, so dpkg unlinks it before this script runs (Policy 6.8) — only
# the re-render is ours. User data under /mnt/data/wb-node-red and the service
# user are intentionally kept (sysusers.d convention: never remove users that
# may still own files).
set -e

RUNTIME_DIR="/mnt/data/wb-node-red-runtime"

case "$1" in
    remove|purge)
        # re-render the remaining gates (ours is already gone) + reload nginx;
        # harmless if absent
        command -v wb-homeui-gates >/dev/null 2>&1 && wb-homeui-gates apply >/dev/null 2>&1 || true
        # Runtime code is package-owned (extracted, dpkg-untracked) — remove it.
        # The user data dir is never touched here.
        rm -rf "$RUNTIME_DIR"
        ;;
esac

#DEBHELPER#

exit 0
