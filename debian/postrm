#!/bin/sh
# Remove the runtime tree on remove/purge. The gate is a plain package file:
# dpkg unlinks it before this script runs (Policy 6.8), so only the re-render is
# ours. User data and the service user stay (sysusers.d: never remove a user
# that may still own files).
set -e

# Test seam: the behavior tests re-root all paths and stub commands on PATH.
ROOT="${WB_NODE_RED_ROOT:-}"

RUNTIME_DIR="$ROOT/mnt/data/wb-node-red-runtime"

case "$1" in
    remove|purge)
        # re-render the remaining gates and reload nginx; harmless if absent
        command -v wb-homeui-gates >/dev/null 2>&1 && wb-homeui-gates apply >/dev/null 2>&1 || true
        # runtime code is package-owned (extracted, dpkg-untracked); user data is not
        rm -rf "$RUNTIME_DIR"
        ;;
esac

#DEBHELPER#

exit 0
