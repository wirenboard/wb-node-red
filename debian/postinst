#!/bin/sh
# Create the service user, place the runtime tree and user data under /mnt/data,
# and wire the nginx auth-gate; also runs as a dpkg trigger on homeui changes.
set -e

# Test seam: the behavior tests re-root all paths and stub commands on PATH.
ROOT="${WB_NODE_RED_ROOT:-}"

SVC_USER="wb-node-red"
DATA_DIR="$ROOT/mnt/data/wb-node-red"
RUNTIME_DIR="$ROOT/mnt/data/wb-node-red-runtime"
RUNTIME_TARBALL="$ROOT/usr/share/wb-node-red/node_modules.tar.gz"
SEED_FLOWS="$ROOT/usr/share/wb-node-red/flows.json"
NGINX_GATE_SRC="$ROOT/usr/share/wb-node-red/nginx/wb-node-red.conf"
NGINX_CONFD="$ROOT/etc/nginx/conf.d"
NGINX_GATE_DST="$NGINX_CONFD/wb-node-red.conf"
# The cache zone must load before the gate that references it: both live in
# conf.d and the cache conf sorts first.
NGINX_CACHE_SRC="$ROOT/usr/share/wb-node-red/nginx/wb-node-red-auth-cache.conf"
NGINX_CACHE_DST="$NGINX_CONFD/wb-node-red-auth-cache.conf"
NGINX_REDIR_SRC="$ROOT/usr/share/wb-node-red/nginx/wb-node-red-redirect.conf"
NGINX_WB_D="$ROOT/etc/nginx/includes/default.wb.d"
NGINX_REDIR_DST="$NGINX_WB_D/wb-node-red-redirect.conf"
SSLIP_CERT="$ROOT/etc/ssl/sslip.pem"
SSLIP_KEY="$ROOT/etc/ssl/sslip.key"
HOMEUI_MENU_SRC="$ROOT/usr/share/wb-node-red/custom-menu.json"
HOMEUI_MENU_DIR="$ROOT/usr/share/wb-mqtt-homeui/custom-menu"
HOMEUI_MENU_DST="$HOMEUI_MENU_DIR/wb-node-red.json"
# gate snippets + isExternal menu rendering both ship in homeui 2.235.4
HOMEUI_MIN="2.235.4~"

reload_nginx_if_valid() {
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
        invoke-rc.d nginx reload >/dev/null 2>&1 || systemctl reload nginx >/dev/null 2>&1 || true
    fi
}

# Tear the gate down; reload only if something was actually removed.
remove_gate_files_and_reload() {
    removed=0
    for f in "$NGINX_GATE_DST" "$NGINX_CACHE_DST" "$NGINX_REDIR_DST"; do
        if [ -e "$f" ]; then
            rm -f "$f"
            removed=1
        fi
    done
    if [ "$removed" = 1 ]; then
        reload_nginx_if_valid
    fi
}

# A 1880 listener while our own unit is inactive = a foreign (manually
# installed) Node-RED; the gate must not expose it on :21880.
port_1880_foreign() {
    command -v ss >/dev/null 2>&1 || return 1
    if systemctl is-active --quiet wb-node-red.service 2>/dev/null; then
        return 1
    fi
    ss -Hltn 2>/dev/null | grep -q ':1880 '
}

# Idempotent in both directions: wire the gate/menu up when the preconditions
# hold, tear them down when they stopped holding.
wire_gate_and_menu() {
    homeui_ver="$(dpkg-query -W -f='${Version}' wb-mqtt-homeui 2>/dev/null || true)"
    homeui_ok=0
    if [ -n "$homeui_ver" ] && dpkg --compare-versions "$homeui_ver" ge "$HOMEUI_MIN"; then
        homeui_ok=1
    fi

    if [ "$homeui_ok" != 1 ]; then
        echo "wb-node-red: wb-mqtt-homeui >= 2.235.4 (service-gate snippets) not installed — the Node-RED port-gate is off and the editor unreachable. It is wired automatically when homeui is upgraded; 'dpkg-reconfigure wb-node-red' also works." >&2
        remove_gate_files_and_reload
    elif [ ! -f "$SSLIP_CERT" ] || [ ! -f "$SSLIP_KEY" ]; then
        echo "wb-node-red: sslip cert ($SSLIP_CERT) not found — skipping the Node-RED port-gate. Open homeui over https once to generate it, then run 'dpkg-reconfigure wb-node-red'." >&2
        remove_gate_files_and_reload
    elif port_1880_foreign; then
        echo "wb-node-red: something else already listens on port 1880 (a manually installed Node-RED?) — skipping the Node-RED port-gate rather than exposing that foreign instance on :21880. Stop it and run 'dpkg-reconfigure wb-node-red'." >&2
        remove_gate_files_and_reload
    elif [ -d "$NGINX_CONFD" ] && [ -f "$NGINX_GATE_SRC" ]; then
        # nginx -t checks the WHOLE config, so on failure restore the current
        # (working) files instead of deleting them.
        nginx_backup="$(mktemp -d)"
        for f in "$NGINX_CACHE_DST" "$NGINX_GATE_DST" "$NGINX_REDIR_DST"; do
            if [ -f "$f" ]; then
                cp -p "$f" "$nginx_backup/$(basename "$f")"
            fi
        done
        # cache zone first — the gate references it
        if [ -f "$NGINX_CACHE_SRC" ]; then
            cp "$NGINX_CACHE_SRC" "$NGINX_CACHE_DST"
        fi
        cp "$NGINX_GATE_SRC" "$NGINX_GATE_DST"
        if [ -d "$NGINX_WB_D" ] && [ -f "$NGINX_REDIR_SRC" ]; then
            cp "$NGINX_REDIR_SRC" "$NGINX_REDIR_DST"
        fi
        if command -v nginx >/dev/null 2>&1; then
            if nginx -t >/dev/null 2>&1; then
                invoke-rc.d nginx reload >/dev/null 2>&1 || systemctl reload nginx >/dev/null 2>&1 || true
            else
                echo "wb-node-red: nginx config test failed with the Node-RED port-gate; restoring the previous config to protect homeui." >&2
                for f in "$NGINX_CACHE_DST" "$NGINX_GATE_DST" "$NGINX_REDIR_DST"; do
                    if [ -f "$nginx_backup/$(basename "$f")" ]; then
                        cp -p "$nginx_backup/$(basename "$f")" "$f"
                    else
                        rm -f "$f"
                    fi
                done
            fi
        fi
        rm -rf "$nginx_backup"
    fi

    # Menu only when homeui can render it AND the gate is actually installed —
    # never a dead "Node-RED" link; a stale entry is cleaned up.
    if [ -d "$HOMEUI_MENU_DIR" ] && [ -f "$HOMEUI_MENU_SRC" ]; then
        if [ "$homeui_ok" = 1 ] && [ -f "$NGINX_GATE_DST" ]; then
            cp "$HOMEUI_MENU_SRC" "$HOMEUI_MENU_DST"
        else
            rm -f "$HOMEUI_MENU_DST"
        fi
    fi
}

case "$1" in
    configure)
        # Everything we own lives on /mnt/data; never unpack onto the small root.
        if ! mountpoint -q "$ROOT/mnt/data"; then
            echo "wb-node-red: /mnt/data is not mounted — aborting (runtime and user data live there)." >&2
            exit 1
        fi

        if ! getent passwd "$SVC_USER" >/dev/null 2>&1; then
            adduser --system --group --no-create-home \
                --home "$DATA_DIR" \
                --gecos "Wiren Board Node-RED" \
                "$SVC_USER"
        fi

        # Replace the runtime on every upgrade. Stop the service first — the
        # tree must not be swapped under a live process (dpkg-reconfigure is
        # not covered by prerm).
        if [ -f "$RUNTIME_TARBALL" ]; then
            deb-systemd-invoke stop wb-node-red.service >/dev/null 2>&1 || true
            mkdir -p "$RUNTIME_DIR"
            # If anything below fails, set -e skips the generated start at the
            # bottom; the trap restarts the service (extra start = no-op).
            trap 'deb-systemd-invoke start wb-node-red.service >/dev/null 2>&1 || true' EXIT
            # Stage on the same filesystem, swap in with renames — a failed
            # extract leaves the old runtime intact; the tarball under
            # /usr/share self-heals any crash on the next configure.
            rm -rf "$RUNTIME_DIR/node_modules.staging"
            mkdir -p "$RUNTIME_DIR/node_modules.staging"
            tar -xzf "$RUNTIME_TARBALL" -C "$RUNTIME_DIR/node_modules.staging"
            rm -rf "$RUNTIME_DIR/node_modules.old"
            [ -e "$RUNTIME_DIR/node_modules" ] && \
                mv "$RUNTIME_DIR/node_modules" "$RUNTIME_DIR/node_modules.old"
            mv "$RUNTIME_DIR/node_modules.staging/node_modules" "$RUNTIME_DIR/node_modules"
            rm -rf "$RUNTIME_DIR/node_modules.old" "$RUNTIME_DIR/node_modules.staging"
            # make the renames durable before power can cut
            sync
        fi

        # Seed if absent, never overwrite — and never through a symlink: the
        # userDir is service-user-writable, a root cp would write through it.
        mkdir -p "$DATA_DIR"
        if [ ! -e "$DATA_DIR/flows.json" ] && [ ! -L "$DATA_DIR/flows.json" ] \
            && [ -f "$SEED_FLOWS" ]; then
            cp "$SEED_FLOWS" "$DATA_DIR/flows.json"
        fi
        chown -R "$SVC_USER:$SVC_USER" "$DATA_DIR"

        wire_gate_and_menu
        ;;

    triggered)
        # homeui changed under us — re-run only the gate/menu wiring.
        wire_gate_and_menu
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
